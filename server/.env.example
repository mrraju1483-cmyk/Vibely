# Copy to .env and fill in. NEVER commit .env
PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=
OTP_PROVIDER=dev
OTP_API_KEY=

# Media uploads. 'local' saves to server/uploads (development only); 'cloudinary' for production
MEDIA_PROVIDER=local
PUBLIC_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Calls (Phase 9). STUN is public. TURN is optional (coturn with static-auth-secret)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_SECRET=

# Vibely AI (Phase 10): the Python service in ../ai-service. Leave AI_SERVICE_URL empty to run without AI (the app shows a friendly message).
AI_SERVICE_URL=
AI_SERVICE_KEY=
AI_TIMEOUT_MS=35000
AI_RATE_LIMIT_MAX=
