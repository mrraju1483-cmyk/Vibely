# Copy to .env and fill in. NEVER commit .env
# Shared secret between the Node backend and this service (16+ characters). Same value as AI_SERVICE_KEY in server/.env
AI_SERVICE_KEY=

# Which LLM provider to call: "anthropic" or "openai" (any OpenAI-compatible API, including local servers)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# Only for AI_PROVIDER=openai with a non-default endpoint (Groq, OpenRouter, Ollama, ...). Example: http://localhost:11434/v1
AI_BASE_URL=

AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=600
# "production" turns off the /docs page
AI_ENV=development
